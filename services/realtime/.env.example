# =============================================================================
# REALTIME SERVICE - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values

# =============================================================================
# Service Configuration
# =============================================================================
NODE_ENV="development"
SERVICE_NAME="realtime"
SERVICE_VERSION="1.0.0"
PORT="3002"
HOST="localhost"

# =============================================================================
# WebSocket Configuration
# =============================================================================
# Socket.IO Settings
SOCKET_IO_CORS_ORIGINS="http://localhost:3000,http://localhost:3010,http://localhost:3020,http://localhost:3030"
SOCKET_IO_PING_TIMEOUT=60000
SOCKET_IO_PING_INTERVAL=25000
MAX_HTTP_BUFFER_SIZE=1048576  # 1MB

# Connection Management
MAX_CONNECTIONS=10000
CONNECTION_TIMEOUT_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=30

# =============================================================================
# Authentication & Authorization
# =============================================================================
# JWT Authentication for WebSocket connections
JWT_SECRET="development-jwt-secret-change-in-production"
JWT_ALGORITHM="HS256"
TOKEN_EXPIRY_MINUTES=60

# Room Access Control
ENABLE_ROOM_AUTHENTICATION="true"
ROOM_ACCESS_CHECK_INTERVAL=300000  # 5 minutes

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis for Socket.IO adapter (multi-instance support)
REDIS_URL="redis://localhost:6379"
REDIS_ADAPTER_DB=4

# Pub/Sub for cross-instance communication
REDIS_PUBSUB_DB=5
PUBSUB_CHANNEL_PREFIX="gbs:realtime"

# =============================================================================
# Channel Configuration
# =============================================================================
# Tee Sheet Channels
TEESHEET_CHANNEL_PREFIX="teesheet:"
TEESHEET_UPDATE_THROTTLE_MS=1000
ENABLE_TEESHEET_SNAPSHOTS="true"

# Booking Channels
BOOKING_CHANNEL_PREFIX="booking:"
BOOKING_UPDATE_IMMEDIATE="true"

# POS Channels
POS_CHANNEL_PREFIX="pos:"
POS_UPDATE_THROTTLE_MS=500

# Admin Channels
ADMIN_CHANNEL_PREFIX="admin:"
ADMIN_BROADCAST_ENABLED="true"

# Public Channels
PUBLIC_CHANNEL_PREFIX="public:"
PUBLIC_RATE_LIMIT=10  # messages per minute

# =============================================================================
# Message Queue Integration
# =============================================================================
# Queue for processing real-time events
QUEUE_REDIS_DB=6
EVENT_QUEUE_NAME="realtime-events"
EVENT_PROCESSING_CONCURRENCY=20

# Message Persistence
PERSIST_MESSAGES="true"
MESSAGE_RETENTION_HOURS=24
MAX_PERSISTED_MESSAGES_PER_ROOM=1000

# =============================================================================
# Event Broadcasting
# =============================================================================
# Booking Events
BROADCAST_BOOKING_CREATED="true"
BROADCAST_BOOKING_UPDATED="true"
BROADCAST_BOOKING_CANCELLED="true"
BROADCAST_SLOT_AVAILABILITY="true"

# Payment Events
BROADCAST_PAYMENT_UPDATES="true"
BROADCAST_PAYMENT_STATUS="true"

# System Events
BROADCAST_SYSTEM_ALERTS="true"
BROADCAST_MAINTENANCE_MODE="true"

# =============================================================================
# Rate Limiting
# =============================================================================
# Message Rate Limiting
ENABLE_RATE_LIMITING="true"
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SECONDS=60
RATE_LIMIT_BLOCK_DURATION_SECONDS=60

# Connection Rate Limiting
CONNECTION_RATE_LIMIT=10  # connections per minute per IP
CONNECTION_BURST_LIMIT=50

# =============================================================================
# Real-time Features
# =============================================================================
# Live Tee Sheet Updates
LIVE_TEESHEET_ENABLED="true"
TEESHEET_REFRESH_INTERVAL_MS=5000
TEESHEET_CONFLICT_RESOLUTION="last_write_wins"

# Live Availability Updates
LIVE_AVAILABILITY_ENABLED="true"
AVAILABILITY_UPDATE_DEBOUNCE_MS=2000

# Live Chat Support
LIVE_CHAT_ENABLED="false"
CHAT_HISTORY_DAYS=30
MAX_CHAT_MESSAGE_LENGTH=1000

# Notifications
PUSH_NOTIFICATIONS_ENABLED="true"
NOTIFICATION_QUEUE_SIZE=10000
NOTIFICATION_RETRY_ATTEMPTS=3

# =============================================================================
# Performance Configuration
# =============================================================================
# Memory Management
NODE_OPTIONS="--max-old-space-size=2048"
MEMORY_USAGE_WARNING_THRESHOLD=80
MAX_MEMORY_USAGE_MB=1536

# Connection Pooling
WEBSOCKET_COMPRESSION="true"
ENABLE_STICKY_SESSIONS="true"

# Message Batching
ENABLE_MESSAGE_BATCHING="true"
BATCH_SIZE=10
BATCH_TIMEOUT_MS=100

# =============================================================================
# Monitoring & Metrics
# =============================================================================
# Connection Metrics
TRACK_CONNECTION_METRICS="true"
METRICS_UPDATE_INTERVAL_MS=30000

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING="true"
SLOW_OPERATION_THRESHOLD_MS=1000

# Health Checks
ENABLE_HEALTH_CHECKS="true"
HEALTH_CHECK_PORT="3005"
HEALTH_CHECK_INTERVAL_SECONDS=30

# Metrics Export
ENABLE_METRICS="true"
METRICS_PORT="9094"

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL="info"
ENABLE_CONNECTION_LOGGING="false"  # Can be noisy
ENABLE_MESSAGE_LOGGING="false"     # Security: Don't log message content
ENABLE_ERROR_LOGGING="true"
ENABLE_PERFORMANCE_LOGGING="true"

# Structured Logging
STRUCTURED_LOGGING="true"
LOG_FORMAT="json"

# =============================================================================
# Security Configuration
# =============================================================================
# Security Headers
ENABLE_SECURITY_HEADERS="true"
ENABLE_CORS="true"

# Message Validation
VALIDATE_MESSAGE_SCHEMAS="true"
MAX_MESSAGE_SIZE_KB=64
ENABLE_XSS_PROTECTION="true"

# Room Security
ENABLE_ROOM_ISOLATION="true"
VALIDATE_ROOM_ACCESS="true"

# =============================================================================
# Error Handling
# =============================================================================
# Error Tracking
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_SAMPLE_RATE=0.1

# Error Recovery
AUTO_RECONNECT_ENABLED="true"
RECONNECT_ATTEMPTS=5
RECONNECT_DELAY_MS=1000

# Alert Configuration
CONNECTION_ERROR_THRESHOLD=100
MESSAGE_ERROR_THRESHOLD=50
ALERT_WEBHOOK_URL=""

# =============================================================================
# Development Configuration
# =============================================================================
ENABLE_DEBUG_LOGGING="true"
ENABLE_WEBSOCKET_DEBUGGING="false"
MOCK_EXTERNAL_EVENTS="false"

# Development Tools
ENABLE_SOCKET_IO_ADMIN="true"
ADMIN_UI_PORT="3006"
ADMIN_UI_PASSWORD="admin123"

# =============================================================================
# Clustering & Scaling
# =============================================================================
# Multi-instance Support
ENABLE_CLUSTERING="false"
CLUSTER_INSTANCES=1
STICKY_SESSION_KEY="io"

# Load Balancing
ENABLE_LOAD_BALANCING="false"
LOAD_BALANCE_STRATEGY="round_robin"  # round_robin|least_connections

# =============================================================================
# Cache Configuration
# =============================================================================
# In-memory Caching
ENABLE_MESSAGE_CACHE="true"
MESSAGE_CACHE_SIZE_MB=128
CACHE_TTL_SECONDS=300

# Room State Caching
ENABLE_ROOM_STATE_CACHE="true"
ROOM_STATE_TTL_SECONDS=600

# =============================================================================
# External Integrations
# =============================================================================
# Push Notification Services
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# Third-party Services
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""