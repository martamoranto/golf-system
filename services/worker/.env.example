# =============================================================================
# WORKER SERVICE - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values

# =============================================================================
# Service Configuration
# =============================================================================
NODE_ENV="development"
SERVICE_NAME="worker"
SERVICE_VERSION="1.0.0"

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# Connection Pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT=30000

# =============================================================================
# Queue Configuration
# =============================================================================
# Redis for Bull Queue
REDIS_URL="redis://localhost:6379"
QUEUE_REDIS_DB=1

# Queue Settings
QUEUE_NAME_PREFIX="gbs"
QUEUE_DEFAULT_JOB_ATTEMPTS=3
QUEUE_DEFAULT_JOB_BACKOFF="exponential"
QUEUE_DEFAULT_DELAY=1000
QUEUE_MAX_JOBS_PER_WORKER=50

# Queue Concurrency
QUEUE_EMAIL_CONCURRENCY=5
QUEUE_SMS_CONCURRENCY=10
QUEUE_BOOKING_CONCURRENCY=20
QUEUE_PAYMENT_CONCURRENCY=3
QUEUE_REPORT_CONCURRENCY=2

# =============================================================================
# Email Processing
# =============================================================================
# SMTP Configuration
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@finalgolf.local"
SMTP_FROM_NAME="Final Golf"

# Email Service Providers
SENDGRID_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
SES_ACCESS_KEY=""
SES_SECRET_KEY=""
SES_REGION="ap-southeast-1"

# Email Templates
EMAIL_TEMPLATE_PATH="./templates/email"
DEFAULT_EMAIL_LOCALE="en"

# =============================================================================
# SMS Processing
# =============================================================================
# SMS Providers
SMS_PROVIDER="semaphore"  # semaphore|twilio|globe

# Semaphore (Philippines)
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="FinalGolf"

# Twilio (International)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Globe Labs (Philippines)
GLOBE_APP_ID=""
GLOBE_APP_SECRET=""
GLOBE_SHORT_CODE=""

# =============================================================================
# Payment Processing
# =============================================================================
# PayMongo Webhooks
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Stripe Webhooks
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Payment Processing Rules
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_DELAY_SECONDS=300
FAILED_PAYMENT_NOTIFICATION_DELAY=3600

# =============================================================================
# Booking Management
# =============================================================================
# Booking Automation
AUTO_RELEASE_HOLDS="true"
HOLD_EXPIRY_MINUTES=15
BOOKING_REMINDER_HOURS=24
BOOKING_CONFIRMATION_DELAY_SECONDS=30

# Cancellation Processing
AUTO_PROCESS_REFUNDS="false"
REFUND_PROCESSING_DELAY_SECONDS=1800
CANCELLATION_FEE_PERCENTAGE=10

# =============================================================================
# Report Generation
# =============================================================================
# Report Processing
REPORT_GENERATION_TIMEOUT_MINUTES=30
REPORT_STORAGE_DAYS=90
AUTOMATED_REPORT_SCHEDULE="0 6 * * *"  # Daily at 6 AM

# Report Delivery
REPORT_EMAIL_RECIPIENTS=""
REPORT_SLACK_WEBHOOK=""

# =============================================================================
# Data Synchronization
# =============================================================================
# External System Sync
SYNC_ENABLED="false"
SYNC_INTERVAL_MINUTES=60
SYNC_BATCH_SIZE=100

# Golf Course Management System
GCMS_SYNC_ENABLED="false"
GCMS_API_URL=""
GCMS_API_KEY=""

# =============================================================================
# File Processing
# =============================================================================
# File Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET_NAME="golf-uploads"
S3_REGION="us-east-1"

# Image Processing
IMAGE_PROCESSING_ENABLED="true"
IMAGE_RESIZE_ENABLED="true"
IMAGE_COMPRESSION_QUALITY=85
THUMBNAIL_SIZES="150x150,300x300,600x600"

# =============================================================================
# Scheduled Jobs
# =============================================================================
# Cron Job Settings
ENABLE_SCHEDULED_JOBS="true"
JOB_TIMEZONE="Asia/Manila"

# Daily Tasks
DAILY_CLEANUP_TIME="02:00"
DAILY_REPORTS_TIME="06:00"
DAILY_BACKUP_TIME="01:00"

# Periodic Tasks
HOLD_CLEANUP_INTERVAL="*/5 * * * *"  # Every 5 minutes
REMINDER_CHECK_INTERVAL="0 */6 * * *"  # Every 6 hours
PAYMENT_CHECK_INTERVAL="*/10 * * * *"  # Every 10 minutes

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Health Checks
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10

# Metrics
ENABLE_METRICS="true"
METRICS_PORT="9091"
METRICS_PATH="/metrics"

# Logging
LOG_LEVEL="info"
ENABLE_STRUCTURED_LOGGING="true"
LOG_FILE_PATH="./logs/worker.log"
LOG_ROTATION_MAX_SIZE="100m"
LOG_ROTATION_MAX_FILES=10

# =============================================================================
# Error Handling
# =============================================================================
# Error Tracking
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Dead Letter Queue
DLQ_ENABLED="true"
DLQ_MAX_ATTEMPTS=5
DLQ_RETRY_DELAY_SECONDS=3600

# Alert Configuration
ALERT_EMAIL=""
ALERT_WEBHOOK_URL=""
CRITICAL_ERROR_THRESHOLD=10
ERROR_RATE_THRESHOLD_PERCENT=5

# =============================================================================
# Development Settings
# =============================================================================
ENABLE_DEBUG_LOGGING="true"
ENABLE_JOB_LOGGING="true"
MOCK_EXTERNAL_SERVICES="false"

# =============================================================================
# Performance Tuning
# =============================================================================
# Memory Management
NODE_OPTIONS="--max-old-space-size=2048"
WORKER_MEMORY_LIMIT_MB=1024

# Job Processing
MAX_CONCURRENT_JOBS=50
JOB_TIMEOUT_MINUTES=30
STALLED_INTERVAL_SECONDS=30
MAX_STALLED_COUNT=3