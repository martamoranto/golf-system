# =============================================================================
# SCHEDULER SERVICE - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values

# =============================================================================
# Service Configuration
# =============================================================================
NODE_ENV="development"
SERVICE_NAME="scheduler"
SERVICE_VERSION="1.0.0"

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# =============================================================================
# Scheduler Configuration
# =============================================================================
# Cron Job Settings
ENABLE_CRON_JOBS="true"
CRON_TIMEZONE="Asia/Manila"
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_MINUTES=60

# Job Locking (Prevents duplicate executions across multiple instances)
ENABLE_JOB_LOCKING="true"
LOCK_TTL_MINUTES=120
LOCK_REDIS_DB=3

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL="redis://localhost:6379"
SCHEDULER_REDIS_DB=3

# =============================================================================
# Booking Management Jobs
# =============================================================================
# Hold Cleanup Job
HOLD_CLEANUP_CRON="*/5 * * * *"  # Every 5 minutes
HOLD_CLEANUP_ENABLED="true"
HOLD_EXPIRY_MINUTES=15
HOLD_GRACE_PERIOD_MINUTES=2

# Booking Reminders
BOOKING_REMINDER_CRON="0 */6 * * *"  # Every 6 hours
BOOKING_REMINDER_ENABLED="true"
REMINDER_LEAD_TIME_HOURS=24
REMINDER_CUTOFF_HOURS=2

# No-Show Processing
NO_SHOW_PROCESSING_CRON="0 2 * * *"  # Daily at 2 AM
NO_SHOW_ENABLED="true"
NO_SHOW_GRACE_PERIOD_MINUTES=30
NO_SHOW_FEE_PERCENTAGE=50

# =============================================================================
# Payment Processing Jobs
# =============================================================================
# Payment Status Sync
PAYMENT_SYNC_CRON="*/10 * * * *"  # Every 10 minutes
PAYMENT_SYNC_ENABLED="true"
PAYMENT_SYNC_BATCH_SIZE=100
PENDING_PAYMENT_TIMEOUT_HOURS=24

# Failed Payment Retry
FAILED_PAYMENT_RETRY_CRON="0 */4 * * *"  # Every 4 hours
FAILED_PAYMENT_RETRY_ENABLED="true"
MAX_PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_BACKOFF_HOURS="1,6,24"

# Refund Processing
REFUND_PROCESSING_CRON="*/15 * * * *"  # Every 15 minutes
AUTO_REFUND_ENABLED="false"
REFUND_APPROVAL_REQUIRED="true"
REFUND_PROCESSING_BATCH_SIZE=50

# =============================================================================
# Reporting Jobs
# =============================================================================
# Daily Reports
DAILY_REPORTS_CRON="0 6 * * *"  # Daily at 6 AM
DAILY_REPORTS_ENABLED="true"
DAILY_REPORT_RECIPIENTS=""

# Weekly Reports
WEEKLY_REPORTS_CRON="0 7 * * 1"  # Mondays at 7 AM
WEEKLY_REPORTS_ENABLED="true"
WEEKLY_REPORT_RECIPIENTS=""

# Monthly Reports
MONTHLY_REPORTS_CRON="0 8 1 * *"  # 1st of month at 8 AM
MONTHLY_REPORTS_ENABLED="true"
MONTHLY_REPORT_RECIPIENTS=""

# Financial Reports
FINANCIAL_REPORTS_CRON="0 9 * * *"  # Daily at 9 AM
FINANCIAL_REPORTS_ENABLED="true"
FINANCIAL_REPORT_RECIPIENTS=""

# =============================================================================
# Data Maintenance Jobs
# =============================================================================
# Database Cleanup
DB_CLEANUP_CRON="0 3 * * 0"  # Sundays at 3 AM
DB_CLEANUP_ENABLED="true"
SOFT_DELETE_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
TEMP_DATA_RETENTION_HOURS=24

# Cache Cleanup
CACHE_CLEANUP_CRON="0 4 * * *"  # Daily at 4 AM
CACHE_CLEANUP_ENABLED="true"
EXPIRED_CACHE_CLEANUP="true"

# File Cleanup
FILE_CLEANUP_CRON="0 5 * * 0"  # Sundays at 5 AM
FILE_CLEANUP_ENABLED="true"
UNUSED_FILE_RETENTION_DAYS=30
TEMP_FILE_RETENTION_HOURS=24

# =============================================================================
# System Maintenance Jobs
# =============================================================================
# Health Check Monitoring
HEALTH_CHECK_CRON="*/5 * * * *"  # Every 5 minutes
HEALTH_CHECK_ENABLED="true"
HEALTH_CHECK_TIMEOUT_SECONDS=30
HEALTH_CHECK_ALERT_THRESHOLD=3

# Performance Monitoring
PERFORMANCE_CHECK_CRON="*/15 * * * *"  # Every 15 minutes
PERFORMANCE_CHECK_ENABLED="true"
SLOW_QUERY_THRESHOLD_MS=5000
HIGH_MEMORY_THRESHOLD_PERCENT=80

# Backup Jobs
BACKUP_CRON="0 1 * * *"  # Daily at 1 AM
BACKUP_ENABLED="true"
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION="true"

# =============================================================================
# Customer Communication Jobs
# =============================================================================
# Email Queue Processing
EMAIL_QUEUE_CRON="*/2 * * * *"  # Every 2 minutes
EMAIL_QUEUE_ENABLED="true"
EMAIL_BATCH_SIZE=50
EMAIL_RATE_LIMIT_PER_MINUTE=100

# SMS Queue Processing
SMS_QUEUE_CRON="*/2 * * * *"  # Every 2 minutes
SMS_QUEUE_ENABLED="true"
SMS_BATCH_SIZE=25
SMS_RATE_LIMIT_PER_MINUTE=50

# Newsletter Processing
NEWSLETTER_CRON="0 10 * * 2"  # Tuesdays at 10 AM
NEWSLETTER_ENABLED="false"
NEWSLETTER_BATCH_SIZE=500

# =============================================================================
# External Integration Jobs
# =============================================================================
# Weather Data Sync
WEATHER_SYNC_CRON="0 */3 * * *"  # Every 3 hours
WEATHER_SYNC_ENABLED="true"
WEATHER_API_KEY=""
WEATHER_FORECAST_DAYS=7

# Third-party Data Sync
EXTERNAL_SYNC_CRON="0 */12 * * *"  # Every 12 hours
EXTERNAL_SYNC_ENABLED="false"
SYNC_BATCH_SIZE=100
SYNC_TIMEOUT_MINUTES=30

# =============================================================================
# Analytics Jobs
# =============================================================================
# Usage Analytics
ANALYTICS_CRON="0 0 * * *"  # Daily at midnight
ANALYTICS_ENABLED="true"
ANALYTICS_RETENTION_DAYS=1095  # 3 years

# Metrics Aggregation
METRICS_AGGREGATION_CRON="*/30 * * * *"  # Every 30 minutes
METRICS_AGGREGATION_ENABLED="true"
METRICS_BATCH_SIZE=1000

# =============================================================================
# Monitoring & Logging
# =============================================================================
# Health Monitoring
ENABLE_HEALTH_ENDPOINT="true"
HEALTH_ENDPOINT_PORT="3004"
HEALTH_ENDPOINT_PATH="/health"

# Metrics
ENABLE_METRICS="true"
METRICS_PORT="9093"

# Logging
LOG_LEVEL="info"
ENABLE_JOB_LOGGING="true"
LOG_JOB_PERFORMANCE="true"
STRUCTURED_LOGGING="true"

# =============================================================================
# Error Handling
# =============================================================================
# Error Tracking
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Job Failure Handling
MAX_JOB_FAILURES=3
JOB_FAILURE_BACKOFF="exponential"
ENABLE_DEAD_LETTER_QUEUE="true"

# Alert Configuration
JOB_FAILURE_ALERT_EMAIL=""
CONSECUTIVE_FAILURE_THRESHOLD=5
CRITICAL_JOB_ALERT_WEBHOOK=""

# =============================================================================
# Development Settings
# =============================================================================
ENABLE_DEBUG_LOGGING="true"
DRY_RUN_MODE="false"
MOCK_EXTERNAL_CALLS="false"

# =============================================================================
# Performance Configuration
# =============================================================================
NODE_OPTIONS="--max-old-space-size=1024"
MAX_MEMORY_USAGE_MB=512
JOB_CONCURRENCY_LIMIT=5