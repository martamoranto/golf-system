# =============================================================================
# WEBHOOKS SERVICE - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values

# =============================================================================
# Service Configuration
# =============================================================================
NODE_ENV="development"
SERVICE_NAME="webhooks"
SERVICE_VERSION="1.0.0"
PORT="3003"
HOST="localhost"

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# =============================================================================
# Security Configuration
# =============================================================================
# Webhook Verification
WEBHOOK_SIGNATURE_VERIFICATION="true"
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_PAYLOAD_SIZE="10mb"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=1000
ENABLE_IP_WHITELIST="false"
ALLOWED_IPS=""

# =============================================================================
# PayMongo Configuration
# =============================================================================
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_WEBHOOK_ENDPOINT="/webhooks/paymongo"

# PayMongo Events
PAYMONGO_EVENTS_ENABLED="payment.paid,payment.failed,payment.processing,source.chargeable"

# =============================================================================
# Stripe Configuration
# =============================================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_ENDPOINT="/webhooks/stripe"

# Stripe Events
STRIPE_EVENTS_ENABLED="payment_intent.succeeded,payment_intent.payment_failed,charge.dispute.created"

# =============================================================================
# SMS Provider Webhooks
# =============================================================================
# Semaphore Status Updates
SEMAPHORE_WEBHOOK_SECRET=""
SEMAPHORE_WEBHOOK_ENDPOINT="/webhooks/semaphore"

# Twilio Status Updates
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_ENDPOINT="/webhooks/twilio"

# Globe Labs Callbacks
GLOBE_APP_SECRET=""
GLOBE_WEBHOOK_ENDPOINT="/webhooks/globe"

# =============================================================================
# Email Provider Webhooks
# =============================================================================
# SendGrid Event Webhook
SENDGRID_WEBHOOK_SECRET=""
SENDGRID_WEBHOOK_ENDPOINT="/webhooks/sendgrid"

# Mailgun Event Webhook
MAILGUN_WEBHOOK_SECRET=""
MAILGUN_WEBHOOK_ENDPOINT="/webhooks/mailgun"

# =============================================================================
# Queue Configuration
# =============================================================================
# Redis for processing webhooks
REDIS_URL="redis://localhost:6379"
WEBHOOK_QUEUE_DB=2

# Queue Processing
WEBHOOK_QUEUE_CONCURRENCY=10
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_BACKOFF="exponential"
WEBHOOK_PROCESSING_TIMEOUT=30000

# =============================================================================
# Event Processing
# =============================================================================
# Event Routing
ENABLE_EVENT_ROUTING="true"
EVENT_ROUTER_CONCURRENCY=20

# Event Storage
STORE_WEBHOOK_PAYLOADS="true"
WEBHOOK_PAYLOAD_RETENTION_DAYS=90
COMPRESS_STORED_PAYLOADS="true"

# =============================================================================
# Notification Configuration
# =============================================================================
# Internal Notifications
INTERNAL_WEBHOOK_URL="http://localhost:3001/internal/webhooks"
INTERNAL_WEBHOOK_SECRET=""

# Real-time Updates
REALTIME_SERVICE_URL="ws://localhost:3002"
ENABLE_REALTIME_NOTIFICATIONS="true"

# =============================================================================
# Monitoring & Logging
# =============================================================================
# Request Logging
ENABLE_REQUEST_LOGGING="true"
LOG_WEBHOOK_PAYLOADS="false"  # Security: Don't log sensitive data
LOG_LEVEL="info"

# Health Monitoring
HEALTH_CHECK_ENDPOINT="/health"
ENABLE_HEALTH_CHECKS="true"

# Metrics
ENABLE_METRICS="true"
METRICS_PORT="9092"

# =============================================================================
# Error Handling
# =============================================================================
# Error Tracking
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Failed Webhook Handling
FAILED_WEBHOOK_QUEUE="failed-webhooks"
FAILED_WEBHOOK_RETRY_HOURS="1,6,24"
ENABLE_DEAD_LETTER_QUEUE="true"

# Alert Configuration
WEBHOOK_FAILURE_ALERT_EMAIL=""
WEBHOOK_FAILURE_THRESHOLD=10
WEBHOOK_FAILURE_WINDOW_MINUTES=15

# =============================================================================
# Development Configuration
# =============================================================================
# Mock Webhooks
ENABLE_MOCK_WEBHOOKS="false"
MOCK_WEBHOOK_DELAY_MS=1000

# Debugging
ENABLE_DEBUG_LOGGING="true"
ENABLE_WEBHOOK_REPLAY="true"
WEBHOOK_REPLAY_RETENTION_HOURS=24

# =============================================================================
# Security Headers
# =============================================================================
ENABLE_SECURITY_HEADERS="true"
ENABLE_CORS="false"  # Webhooks typically don't need CORS
ENABLE_HELMET="true"

# =============================================================================
# Webhook Validation
# =============================================================================
# Signature Validation
STRICT_SIGNATURE_VALIDATION="true"
ALLOW_TIMESTAMP_TOLERANCE_SECONDS=300  # 5 minutes

# Payload Validation
VALIDATE_WEBHOOK_SCHEMAS="true"
REJECT_UNKNOWN_EVENTS="false"

# =============================================================================
# Performance Configuration
# =============================================================================
# Connection Pooling
HTTP_KEEP_ALIVE="true"
HTTP_TIMEOUT="30000"
MAX_CONCURRENT_REQUESTS=100

# Memory Management
NODE_OPTIONS="--max-old-space-size=1024"

# =============================================================================
# Webhook Analytics
# =============================================================================
# Analytics Collection
ENABLE_WEBHOOK_ANALYTICS="true"
ANALYTICS_RETENTION_DAYS=365

# Performance Metrics
TRACK_RESPONSE_TIMES="true"
TRACK_PAYLOAD_SIZES="true"
TRACK_ERROR_RATES="true"

# =============================================================================
# Third-party Integrations
# =============================================================================
# Customer Support
INTERCOM_WEBHOOK_SECRET=""
ZENDESK_WEBHOOK_SECRET=""

# Marketing Automation
MAILCHIMP_WEBHOOK_SECRET=""
KLAVIYO_WEBHOOK_SECRET=""

# Analytics
MIXPANEL_WEBHOOK_SECRET=""
SEGMENT_WEBHOOK_SECRET=""