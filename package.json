{
  "name": "final-golf-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Golf Booking SaaS Platform - A comprehensive B2B SaaS platform for golf courses with booking management, POS, and marketplace features",
  "author": "Final Golf Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.6.0"
  },
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @gbs/web dev",
    "dev:admin": "pnpm --filter @gbs/admin dev",
    "dev:api": "pnpm --filter @gbs/api dev",
    "dev:packages": "turbo run dev --filter='./packages/*' --parallel",
    "dev:services": "turbo run dev --filter='./services/*' --parallel",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:apps": "turbo run build --filter='./apps/*'",
    "build:services": "turbo run build --filter='./services/*'",
    "build:production": "pnpm build:packages && pnpm build:apps && pnpm build:services",
    "build:affected": "turbo run build --filter='...[HEAD^1]'",
    "start": "turbo run start",
    "start:web": "pnpm --filter @gbs/web start",
    "start:admin": "pnpm --filter @gbs/admin start",
    "start:api": "pnpm --filter @gbs/api start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:packages": "turbo run lint --filter='./packages/*'",
    "lint:apps": "turbo run lint --filter='./apps/*'",
    "lint:affected": "turbo run lint --filter='...[HEAD^1]'",
    "type-check": "turbo run type-check",
    "type-check:packages": "turbo run type-check --filter='./packages/*'",
    "type-check:apps": "turbo run type-check --filter='./apps/*'",
    "type-check:all": "turbo run type-check --parallel",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:packages": "turbo run test --filter='./packages/*'",
    "test:apps": "turbo run test --filter='./apps/*'",
    "test:affected": "turbo run test --filter='...[HEAD^1]'",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "clean": "turbo run clean && pnpm clean:deps",
    "clean:deps": "rm -rf node_modules",
    "clean:build": "turbo run clean",
    "clean:cache": "turbo run clean && rm -rf .turbo",
    "clean:modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean:dist": "find . -name 'dist' -type d -prune -exec rm -rf '{}' + && find . -name '.next' -type d -prune -exec rm -rf '{}' +",
    "clean:all": "pnpm clean:modules && pnpm clean:dist && pnpm clean:cache",
    "reset": "pnpm clean:all && pnpm install",
    "reset:hard": "pnpm clean:all && rm -rf pnpm-lock.yaml && pnpm install",
    "db:generate": "pnpm --filter @gbs/database db:generate || echo 'Database package not found - skipping generate'",
    "db:migrate": "pnpm --filter @gbs/database db:migrate || echo 'Database package not found - skipping migrate'",
    "db:migrate:dev": "pnpm --filter @gbs/database db:migrate:dev || echo 'Database package not found - skipping migrate:dev'",
    "db:migrate:reset": "pnpm --filter @gbs/database db:migrate:reset || echo 'Database package not found - skipping migrate:reset'",
    "db:reset": "pnpm --filter @gbs/database db:reset || echo 'Database package not found - skipping reset'",
    "db:seed": "pnpm --filter @gbs/database db:seed || echo 'Database package not found - skipping seed'",
    "db:studio": "pnpm --filter @gbs/database db:studio || echo 'Database package not found - skipping studio'",
    "db:push": "pnpm --filter @gbs/database db:push || echo 'Database package not found - skipping push'",
    "db:setup": "pnpm db:generate && pnpm db:migrate:dev && pnpm db:seed",
    "db:refresh": "pnpm db:migrate:reset && pnpm db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:packages": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:apps": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "ci:build": "turbo run build --cache-dir=.turbo",
    "ci:test": "turbo run test --cache-dir=.turbo",
    "ci:lint": "turbo run lint --cache-dir=.turbo",
    "ci:type-check": "turbo run type-check --cache-dir=.turbo",
    "ci:validate": "pnpm ci:lint && pnpm ci:type-check && pnpm ci:test && pnpm ci:build",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm type-check && pnpm test",
    "postinstall": "pnpm db:generate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!@gbs/database && changeset publish",
    "prepare": "husky",
    "workspace:info": "pnpm -r exec pwd",
    "workspace:update": "pnpm update -r --latest",
    "workspace:outdated": "pnpm outdated -r",
    "setup": "node scripts/dev-setup.sh",
    "validate": "node scripts/validate-workspace.js",
    "check:deps": "node scripts/check-deps.js",
    "check:health": "pnpm validate && pnpm check:deps",
    "doctor": "pnpm check:health && pnpm ci:validate",
    "docker:up": "scripts/docker-dev.sh up",
    "docker:down": "scripts/docker-dev.sh down",
    "docker:restart": "scripts/docker-dev.sh restart",
    "docker:status": "scripts/docker-dev.sh status",
    "docker:logs": "scripts/docker-dev.sh logs",
    "docker:health": "scripts/docker-dev.sh health",
    "docker:reset": "scripts/docker-dev.sh reset",
    "services:up": "pnpm docker:up",
    "services:down": "pnpm docker:down",
    "services:status": "pnpm docker:status",
    "env:setup": "scripts/setup-env.sh",
    "env:validate": "node scripts/validate-env.js",
    "env:generate-secrets": "node scripts/validate-env.js --generate-secrets",
    "git:hooks": "husky install",
    "git:commit": "git-cz",
    "git:check": "pnpm lint-staged",
    "commit": "git-cz"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-turbo": "^1.12.4",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "@t3-oss/env-nextjs": "^0.9.2",
    "prisma": "^5.9.1",
    "zod": "^3.22.4"
  },
  "lint-staged": {
    "*.{jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css,scss,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'pnpm type-check || echo \"Type check failed but continuing...\"'"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.prisma": [
      "prettier --write"
    ],
    "*.env.example": [
      "prettier --write --parser sh"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.2.55",
      "@types/react-dom": "^18.2.19"
    },
    "patchedDependencies": {},
    "allowedDeprecatedVersions": {
      "inflight": "1.0.6",
      "glob": "7.2.3"
    }
  },
  "keywords": [
    "golf",
    "booking",
    "saas",
    "monorepo",
    "nextjs",
    "typescript",
    "prisma",
    "trpc",
    "pnpm-workspace"
  ]
}
