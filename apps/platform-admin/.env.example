# =============================================================================
# PLATFORM ADMIN - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the required values

# =============================================================================
# Application Configuration
# =============================================================================
NEXT_PUBLIC_APP_NAME="Final Golf Platform Admin"
NEXT_PUBLIC_APP_DESCRIPTION="Super admin dashboard for platform management"

# =============================================================================
# API Configuration
# =============================================================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3002"

# =============================================================================
# Authentication Configuration
# =============================================================================
NEXTAUTH_URL="http://localhost:3030"
NEXTAUTH_SECRET="development-secret-key-change-in-production"

# Super Admin Access Control
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_ROLES="platform_admin,system_admin"
MFA_REQUIRED="true"
MFA_ISSUER="Final Golf Platform"

# Session Security
SESSION_TIMEOUT_MINUTES=60
REQUIRE_IP_WHITELIST="false"
ALLOWED_IPS=""

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# Database Administration
ENABLE_DB_ADMIN_PANEL="true"
DB_BACKUP_ENABLED="true"
DB_BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# =============================================================================
# Multi-Tenant Management
# =============================================================================
# Tenant Configuration
DEFAULT_TENANT_PLAN="starter"
TENANT_TRIAL_DAYS=14
TENANT_MAX_USERS=1000
TENANT_ISOLATION_LEVEL="database"  # database|schema|row

# Tenant Onboarding
AUTO_TENANT_PROVISION="false"
TENANT_APPROVAL_REQUIRED="true"
TENANT_SETUP_WIZARD_ENABLED="true"

# =============================================================================
# Billing & Subscription Management
# =============================================================================
# Stripe Configuration for Billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PROFESSIONAL=""
STRIPE_PRICE_ID_ENTERPRISE=""

# Billing Settings
BILLING_CYCLE="monthly"  # monthly|annual
TRIAL_PERIOD_DAYS=14
LATE_PAYMENT_GRACE_DAYS=7
AUTO_SUSPEND_OVERDUE_ACCOUNTS="true"

# =============================================================================
# System Monitoring
# =============================================================================
# Application Performance Monitoring
APM_ENABLED="true"
NEWRELIC_LICENSE_KEY=""
DATADOG_API_KEY=""

# Log Aggregation
LOG_AGGREGATION_ENABLED="true"
ELASTICSEARCH_URL=""
KIBANA_URL=""

# Metrics Collection
PROMETHEUS_ENDPOINT=""
GRAFANA_URL=""

# =============================================================================
# Feature Management
# =============================================================================
# Feature Flags Control
FEATURE_FLAG_PROVIDER="launchdarkly"  # launchdarkly|unleash|custom
LAUNCHDARKLY_SDK_KEY=""
UNLEASH_API_URL=""

# Global Feature Controls
GLOBAL_MAINTENANCE_MODE="false"
GLOBAL_READ_ONLY_MODE="false"
EMERGENCY_DISABLE_FEATURES=""

# =============================================================================
# Security & Compliance
# =============================================================================
# Audit Logging
AUDIT_LOG_ENABLED="true"
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
AUDIT_LOG_EXPORT_ENABLED="true"

# Compliance
GDPR_COMPLIANCE_ENABLED="true"
DATA_RETENTION_DAYS=2555
AUTOMATED_DATA_DELETION="false"

# Security Monitoring
SECURITY_SCAN_ENABLED="true"
VULNERABILITY_ALERTS="true"
SECURITY_HEADERS_ENABLED="true"

# =============================================================================
# Communication & Notifications
# =============================================================================
# System Notifications
SYSTEM_NOTIFICATION_EMAIL=""
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# Emergency Communications
EMERGENCY_CONTACT_EMAIL=""
EMERGENCY_SMS_NUMBER=""
INCIDENT_NOTIFICATION_WEBHOOK=""

# =============================================================================
# Data Management
# =============================================================================
# Data Export/Import
BULK_EXPORT_ENABLED="true"
BULK_IMPORT_ENABLED="true"
DATA_MIGRATION_ENABLED="false"

# Backup Configuration
BACKUP_PROVIDER="s3"  # s3|gcs|azure
BACKUP_BUCKET="final-golf-backups"
BACKUP_RETENTION_DAYS=90
ENCRYPTED_BACKUPS="true"

# =============================================================================
# Platform Analytics
# =============================================================================
# Usage Analytics
PLATFORM_ANALYTICS_ENABLED="true"
ANALYTICS_DATA_RETENTION_DAYS=1095  # 3 years

# Business Intelligence
BI_DATABASE_URL=""
BI_DASHBOARD_URL=""
AUTOMATED_REPORTS_ENABLED="true"

# =============================================================================
# External Integrations
# =============================================================================
# Payment Processors
PAYMONGO_PLATFORM_KEY=""
STRIPE_PLATFORM_KEY=""

# Third-party Services
CRM_INTEGRATION_ENABLED="false"
CRM_API_URL=""
CRM_API_KEY=""

# Marketing Automation
MAILCHIMP_API_KEY=""
SENDGRID_API_KEY=""

# =============================================================================
# Development & Staging
# =============================================================================
# Environment Management
STAGING_ENVIRONMENT_URL=""
DEVELOPMENT_ENVIRONMENT_URL=""
FEATURE_BRANCH_DEPLOYMENTS="true"

# =============================================================================
# Cache Configuration
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# File Storage
# =============================================================================
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET_NAME="golf-uploads"
S3_REGION="us-east-1"

# Platform Assets
PLATFORM_ASSETS_BUCKET="platform-assets"
TENANT_ASSETS_BUCKET="tenant-assets"

# =============================================================================
# Development Settings
# =============================================================================
NODE_ENV="development"
ENABLE_DEBUG_LOGGING="true"
NEXT_TELEMETRY_DISABLED="1"

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_FEATURE_TENANT_ANALYTICS="true"
NEXT_PUBLIC_FEATURE_BILLING_MANAGEMENT="true"
NEXT_PUBLIC_FEATURE_FEATURE_FLAG_UI="true"
NEXT_PUBLIC_FEATURE_SYSTEM_HEALTH="true"
NEXT_PUBLIC_FEATURE_AUDIT_LOGS="true"

# =============================================================================
# Monitoring & Alerts
# =============================================================================
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
POSTHOG_KEY=""