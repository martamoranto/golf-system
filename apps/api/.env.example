# =============================================================================
# API GATEWAY - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV="development"
PORT="3001"
HOST="localhost"

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# Database Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT=30000

# =============================================================================
# Authentication & Security
# =============================================================================
JWT_SECRET="development-jwt-secret-change-in-production"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_SECRET="development-refresh-secret-change-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Session Configuration
SESSION_SECRET="development-session-secret-change-in-production"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3010,http://localhost:3020,http://localhost:3030"

# =============================================================================
# Payment Configuration
# =============================================================================
# PayMongo (Philippines)
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_WEBHOOK_URL="http://localhost:3001/webhooks/paymongo"

# Stripe (International)
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_URL="http://localhost:3001/webhooks/stripe"

# =============================================================================
# Cache Configuration
# =============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="gbs:"
REDIS_SESSION_PREFIX="sess:"
REDIS_CACHE_TTL=3600

# =============================================================================
# File Storage Configuration
# =============================================================================
# S3-compatible storage (MinIO in development)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET_NAME="golf-uploads"
S3_PUBLIC_BUCKET="golf-public"
S3_REGION="us-east-1"

# Upload Limits
MAX_FILE_SIZE="10485760"  # 10MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# =============================================================================
# Email Configuration
# =============================================================================
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@finalgolf.local"
SMTP_FROM_NAME="Final Golf"

# =============================================================================
# External APIs
# =============================================================================
# SMS Provider
SEMAPHORE_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Maps & Location
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# Weather API
OPENWEATHER_API_KEY=""

# =============================================================================
# Queue Configuration
# =============================================================================
# Bull Queue Redis connection
QUEUE_REDIS_URL="redis://localhost:6379"
QUEUE_REDIS_DB=1

# Job Settings
QUEUE_DEFAULT_JOB_ATTEMPTS=3
QUEUE_DEFAULT_JOB_BACKOFF="exponential"
QUEUE_DEFAULT_JOB_DELAY=1000

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL="info"
ENABLE_REQUEST_LOGGING="true"
ENABLE_QUERY_LOGGING="false"
ENABLE_ERROR_REPORTING="true"

# =============================================================================
# Business Configuration
# =============================================================================
# Booking Rules
DEFAULT_BOOKING_WINDOW_DAYS=14
CANCELLATION_WINDOW_HOURS=24
HOLD_EXPIRY_MINUTES=15

# Payment Settings
DEFAULT_CURRENCY="PHP"
MINIMUM_DEPOSIT_PERCENTAGE=50

# =============================================================================
# Development Features
# =============================================================================
ENABLE_API_DOCS="true"
ENABLE_GRAPHQL_PLAYGROUND="true"
ENABLE_TRPC_PANEL="true"

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Health Check
HEALTH_CHECK_TIMEOUT=5000

# Metrics
ENABLE_METRICS="true"
METRICS_PORT="9090"