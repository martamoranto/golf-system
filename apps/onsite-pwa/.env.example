# =============================================================================
# ONSITE PWA - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the required values

# =============================================================================
# PWA Configuration
# =============================================================================
NEXT_PUBLIC_APP_NAME="Final Golf Onsite"
NEXT_PUBLIC_APP_SHORT_NAME="GBS Onsite"
NEXT_PUBLIC_APP_DESCRIPTION="On-site operations for walk-ins and live golf course management"

# =============================================================================
# API Configuration
# =============================================================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3002"

# =============================================================================
# Authentication Configuration
# =============================================================================
NEXTAUTH_URL="http://localhost:3010"
NEXTAUTH_SECRET="development-secret-key-change-in-production"

# Staff PIN Authentication
STAFF_PIN_LENGTH=4
STAFF_PIN_EXPIRY_HOURS=8

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# =============================================================================
# POS Integration
# =============================================================================
# Hardware Integration
CASH_DRAWER_PORT=""
RECEIPT_PRINTER_IP=""
BARCODE_SCANNER_PORT=""

# Payment Terminal
PAYMENT_TERMINAL_TYPE="simulator"  # simulator|ingenico|verifone
PAYMENT_TERMINAL_IP=""
PAYMENT_TERMINAL_PORT="9001"

# =============================================================================
# Real-time Features
# =============================================================================
# WebSocket for live tee sheet updates
NEXT_PUBLIC_REALTIME_URL="ws://localhost:3002"

# Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@finalgolf.com"

# =============================================================================
# File Storage
# =============================================================================
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET_NAME="golf-uploads"
S3_REGION="us-east-1"

# =============================================================================
# Offline Capabilities
# =============================================================================
ENABLE_OFFLINE_MODE="true"
OFFLINE_STORAGE_QUOTA_MB=50
SYNC_INTERVAL_SECONDS=30

# =============================================================================
# Course-Specific Settings
# =============================================================================
# These would be dynamically loaded per course
DEFAULT_COURSE_TIMEZONE="Asia/Manila"
DEFAULT_COURSE_CURRENCY="PHP"

# Tee Sheet Configuration
TEE_SHEET_REFRESH_INTERVAL=10000  # 10 seconds
AUTO_REFRESH_ENABLED="true"

# =============================================================================
# Hardware Features
# =============================================================================
# Device Capabilities
ENABLE_CAMERA="true"
ENABLE_GPS="true"
ENABLE_NFC="false"

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_FEATURE_WALK_IN_BOOKING="true"
NEXT_PUBLIC_FEATURE_QUICK_CHECKOUT="true"
NEXT_PUBLIC_FEATURE_INVENTORY_SCAN="true"
NEXT_PUBLIC_FEATURE_MEMBER_LOOKUP="true"
NEXT_PUBLIC_FEATURE_WEATHER_WIDGET="true"

# =============================================================================
# Development Settings
# =============================================================================
NODE_ENV="development"
ENABLE_DEBUG_LOGGING="true"
NEXT_TELEMETRY_DISABLED="1"

# =============================================================================
# Cache Configuration
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Monitoring
# =============================================================================
SENTRY_DSN=""
POSTHOG_KEY=""