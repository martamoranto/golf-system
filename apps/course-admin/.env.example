# =============================================================================
# COURSE ADMIN - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the required values

# =============================================================================
# Application Configuration
# =============================================================================
NEXT_PUBLIC_APP_NAME="Final Golf Course Admin"
NEXT_PUBLIC_APP_DESCRIPTION="Course administration and management dashboard"

# =============================================================================
# API Configuration
# =============================================================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3002"

# =============================================================================
# Authentication Configuration
# =============================================================================
NEXTAUTH_URL="http://localhost:3020"
NEXTAUTH_SECRET="development-secret-key-change-in-production"

# Role-based Access Control
ADMIN_ROLES="course_admin,course_manager,pro_shop_manager"
REQUIRED_PERMISSIONS="course:read,course:write,bookings:manage"

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# =============================================================================
# Course Management
# =============================================================================
# Multi-course support
DEFAULT_COURSE_ID=""
COURSE_SELECTION_REQUIRED="false"

# Tee Sheet Management
MAX_BOOKING_DAYS_AHEAD=90
SLOT_DURATION_MINUTES=10
EARLIEST_TEE_TIME="06:00"
LATEST_TEE_TIME="18:00"

# =============================================================================
# Staff Management
# =============================================================================
# Staff Authentication
STAFF_PASSWORD_MIN_LENGTH=8
STAFF_SESSION_TIMEOUT_HOURS=8
REQUIRE_PASSWORD_CHANGE_DAYS=90

# =============================================================================
# Reporting & Analytics
# =============================================================================
# Report Generation
REPORT_CACHE_TTL_MINUTES=30
MAX_REPORT_DATE_RANGE_DAYS=365
ENABLE_AUTOMATED_REPORTS="true"

# Analytics Integration
GOOGLE_ANALYTICS_ID=""
CUSTOM_ANALYTICS_ENDPOINT=""

# =============================================================================
# Payment Configuration
# =============================================================================
# Payment Processing
PAYMONGO_PUBLIC_KEY=""
STRIPE_PUBLIC_KEY=""

# Refund Management
AUTO_REFUND_ENABLED="false"
REFUND_APPROVAL_REQUIRED="true"
REFUND_WINDOW_HOURS=24

# =============================================================================
# Inventory Management
# =============================================================================
# Stock Management
LOW_STOCK_THRESHOLD=10
ENABLE_AUTO_REORDER="false"
STOCK_ALERT_EMAIL=""

# =============================================================================
# Customer Communication
# =============================================================================
# Email Templates
EMAIL_TEMPLATE_BOOKING_CONFIRMATION=""
EMAIL_TEMPLATE_BOOKING_REMINDER=""
EMAIL_TEMPLATE_CANCELLATION=""

# SMS Configuration
SMS_PROVIDER="semaphore"  # semaphore|twilio
SMS_SENDER_NAME="FinalGolf"

# =============================================================================
# File Storage
# =============================================================================
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET_NAME="golf-uploads"
S3_REGION="us-east-1"

# Document Storage
DOCUMENT_BUCKET="golf-documents"
MAX_DOCUMENT_SIZE_MB=5

# =============================================================================
# External Integrations
# =============================================================================
# Weather API
WEATHER_API_KEY=""
WEATHER_PROVIDER="openweather"  # openweather|weatherapi

# Golf Course Management System Integration
GCMS_API_URL=""
GCMS_API_KEY=""
GCMS_SYNC_ENABLED="false"

# =============================================================================
# Business Rules
# =============================================================================
# Booking Rules
ADVANCE_BOOKING_DAYS=14
SAME_DAY_BOOKING_CUTOFF="10:00"
MEMBER_PRIORITY_HOURS=24

# Pricing Rules
DYNAMIC_PRICING_ENABLED="false"
SURGE_PRICING_MULTIPLIER=1.5
DISCOUNT_CODE_ENABLED="true"

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_FEATURE_MULTI_COURSE="false"
NEXT_PUBLIC_FEATURE_DYNAMIC_PRICING="false"
NEXT_PUBLIC_FEATURE_LOYALTY_MANAGEMENT="false"
NEXT_PUBLIC_FEATURE_COACH_SCHEDULING="false"
NEXT_PUBLIC_FEATURE_EVENT_MANAGEMENT="false"
NEXT_PUBLIC_FEATURE_TOURNAMENT_MODE="false"

# =============================================================================
# Cache Configuration
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Development Settings
# =============================================================================
NODE_ENV="development"
ENABLE_DEBUG_LOGGING="true"
NEXT_TELEMETRY_DISABLED="1"

# =============================================================================
# Monitoring & Alerts
# =============================================================================
# Error Tracking
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Performance Monitoring
POSTHOG_KEY=""
POSTHOG_HOST=""

# Alert Configuration
ALERT_EMAIL=""
ALERT_WEBHOOK_URL=""
CRITICAL_ERROR_THRESHOLD=10