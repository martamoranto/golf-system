# =============================================================================
# CUSTOMER WEB APP - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the required values
# Rename from current "web" to "customer" app when restructured

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/final_golf_dev"

# =============================================================================
# NextAuth Configuration
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-secret-key-change-in-production"

# OAuth Provider Secrets (Required for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# =============================================================================
# API Configuration
# =============================================================================
# Internal API endpoints
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3002"

# External APIs
NEXT_PUBLIC_MAPS_API_KEY=""
NEXT_PUBLIC_ANALYTICS_ID=""

# =============================================================================
# File Upload Configuration
# =============================================================================
# S3-compatible storage (MinIO in development)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET_NAME="golf-uploads"
S3_REGION="us-east-1"
S3_PUBLIC_BUCKET="golf-public"

# =============================================================================
# Payment Configuration
# =============================================================================
# PayMongo (Philippines)
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Stripe (International)
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# =============================================================================
# Email Configuration
# =============================================================================
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@finalgolf.local"

# =============================================================================
# Cache Configuration
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_FEATURE_SOCIAL_LOGIN="true"
NEXT_PUBLIC_FEATURE_GUEST_BOOKING="true"
NEXT_PUBLIC_FEATURE_LOYALTY_PROGRAM="false"
NEXT_PUBLIC_FEATURE_COACHING_MARKETPLACE="false"
NEXT_PUBLIC_FEATURE_CLASSIFIEDS="false"

# =============================================================================
# Development Configuration
# =============================================================================
NODE_ENV="development"
ENABLE_DEBUG_LOGGING="true"
ENABLE_QUERY_LOGGING="false"
NEXT_TELEMETRY_DISABLED="1"

# =============================================================================
# Monitoring & Analytics
# =============================================================================
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST=""