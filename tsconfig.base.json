{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "baseUrl": ".",
    "paths": {
      "@gbs/ui": ["./packages/ui/src/index.ts"],
      "@gbs/ui/*": ["./packages/ui/src/*"],
      "@gbs/database": ["./packages/database/src/index.ts"],
      "@gbs/database/*": ["./packages/database/src/*"],
      "@gbs/shared": ["./packages/shared/src/index.ts"],
      "@gbs/shared/*": ["./packages/shared/src/*"],
      "@gbs/config": ["./packages/config/src/index.ts"],
      "@gbs/config/*": ["./packages/config/src/*"],
      "@gbs/auth": ["./packages/auth/src/index.ts"],
      "@gbs/auth/*": ["./packages/auth/src/*"],
      "@gbs/api": ["./packages/api/src/index.ts"],
      "@gbs/api/*": ["./packages/api/src/*"],
      "@gbs/hooks": ["./packages/hooks/src/index.ts"],
      "@gbs/hooks/*": ["./packages/hooks/src/*"],
      "@gbs/utils": ["./packages/utils/src/index.ts"],
      "@gbs/utils/*": ["./packages/utils/src/*"],
      "@gbs/validations": ["./packages/validations/src/index.ts"],
      "@gbs/validations/*": ["./packages/validations/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "**/dist",
    "build",
    "**/build",
    ".next",
    "**/.next",
    "coverage",
    "**/coverage"
  ]
}