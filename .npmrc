# PNPM Configuration for Final Golf SaaS Monorepo

# Dependency hoisting strategy
# 'pattern' hoists only packages that match the pattern
# This prevents version conflicts while maintaining workspace efficiency
hoist-pattern[]=*

# Strict peer dependencies
# Ensures all peer dependencies are explicitly installed
strict-peer-dependencies=true

# Shamefully hoist for compatibility with legacy packages
# This should be used sparingly and only when necessary
shamefully-hoist=false

# Public hoist pattern for packages that need to be available globally
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Prevent auto install of peer dependencies
auto-install-peers=false

# Use node linker for better performance
node-linker=isolated

# Store directory (can be customized if needed)
# store-dir=~/.pnpm-store

# Registry configuration (default to npm)
registry=https://registry.npmjs.org/

# Enable lockfile validation
lockfile-include-tarball-url=true

# Side effects cache
side-effects-cache=true
side-effects-cache-readonly=false