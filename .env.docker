# Docker Development Environment Variables
# These variables are used by the Docker Compose setup

# PostgreSQL Configuration
POSTGRES_DB=final_golf_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/final_golf_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_UPLOADS=golf-uploads
MINIO_BUCKET_PUBLIC=golf-public
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=golf-uploads
S3_REGION=us-east-1

# Email Configuration (Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@finalgolf.local

# Development URLs
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development-secret-key-change-in-production

# API Configuration
API_URL=http://localhost:3001
WS_URL=ws://localhost:3002

# Feature Flags for Development
ENABLE_DEBUG_LOGGING=true
ENABLE_QUERY_LOGGING=true
ENABLE_EMAIL_TESTING=true